{
  "name": "WorkoutLog",
  "type": "object",
  "properties": {
    "access_code": {
      "type": "string"
    },
    "student_name": {
      "type": "string"
    },
    "log_date": {
      "type": "string",
      "format": "date"
    },
    "workout_type": {
      "type": "string"
    },
    "difficulty_rating": {
      "type": "number"
    },
    "energy_rating": {
      "type": "number"
    },
    "prs_hit": {
      "type": "string"
    },
    "strong_points": {
      "type": "string"
    },
    "weak_points": {
      "type": "string"
    },
    "pain_issues": {
      "type": "string"
    },
    "questions": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "access_code",
    "log_date"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}